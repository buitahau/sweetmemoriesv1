# Environment variables for SweetMemories.
# Copy to .env and fill in as features add them. Never commit real values.

# Postgres connection string for YOUR local database (your own Neon branch or a local Postgres).
# Never use the dev Worker's database here: that one is a Worker secret (wrangler secret put DATABASE_URL --env dev).
# No code reads it yet; the first database feature will.
DATABASE_URL=
