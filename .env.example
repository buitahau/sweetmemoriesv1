# Environment variables for SweetMemories.
# Copy to .env and fill in as features add them. Never commit real values.

# Postgres connection string for YOUR local database (your own Neon branch; a plain local Postgres does not work unless a Neon proxy is in front of it).
# Never use the dev Worker's database here: that one is a Worker secret (wrangler secret put DATABASE_URL --env dev).
# Read per request by getDb() in src/server/db/; also used by pnpm db:migrate.
DATABASE_URL=

# Google sign-in (Better Auth). Create an OAuth client in Google Cloud Console (scopes openid email profile)
# with redirect URI http://localhost:3000/api/auth/callback/google. Use the same single OAuth client as the dev Worker (it has both redirect URIs); copy its ID and secret from the Google Cloud Console, not from GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret for signing sessions (for example `openssl rand -base64 32`). Use a different value from dev.
BETTER_AUTH_SECRET=
# Base URL of the app, authoritative for Better Auth baseURL and trustedOrigins. Locally: http://localhost:3000.
# `pnpm start` runs `wrangler dev --env dev`, which sets SITE_URL to the dev Worker URL, so set SITE_URL here too (a .env value or .dev.vars overrides it).
SITE_URL=http://localhost:3000
# Search indexing (ADR 0006). "true" only in production; any other or missing value renders noindex, nofollow.
# SITE_URL above also drives SEO (canonical, og:url, og:image). `pnpm start` gets "false" from env.dev.vars unless this file overrides it.
SITE_INDEXABLE=false
# Fallback only, used when SITE_URL is unset.
BETTER_AUTH_URL=
