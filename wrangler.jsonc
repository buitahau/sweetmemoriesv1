{
  // Used directly by `wrangler ... -c wrangler.jsonc`. Nitro also merges this file
  // into .output/server/wrangler.json, which wrangler rejects when it has `env`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetmemories",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "env": {
    "dev": {
      "name": "sweetmemories-dev",
      "workers_dev": true,
      // Plain var (ADR 0006). Better Auth baseURL comes from SITE_URL; without it every
      // /api/auth/* request answers 503. Do not also push SITE_URL from CI.
      "vars": { "SITE_URL": "https://sweetmemories-dev.haubuitatmp.workers.dev" }
    }
  }
}
