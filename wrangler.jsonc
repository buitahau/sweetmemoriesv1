{
  // Used directly by `wrangler ... -c wrangler.jsonc`. Nitro also merges this file
  // into .output/server/wrangler.json, which wrangler rejects when it has `env`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sweetmemories",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "env": {
    "dev": {
      "name": "sweetmemories-dev",
      "workers_dev": true,
      // Plain vars (ADR 0006). SITE_URL is Better Auth's baseURL and the SEO origin; without
      // it every /api/auth/* request answers 503. SITE_INDEXABLE is "true" only in
      // production, so dev is noindex. Do not also push these from CI.
      "vars": {
        "SITE_URL": "https://sweetmemories-dev.haubuitatmp.workers.dev",
        "SITE_INDEXABLE": "false"
      }
    }
  }
}
